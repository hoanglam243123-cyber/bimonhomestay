# Sao chép thành .env khi chạy trên máy. Trên Hostinger: khai báo trong hPanel > Node.js > Environment variables.
PORT=3000
SITE_URL=https://bimonhomestay.com

# Đăng nhập trang /admin để xem yêu cầu đặt phòng
ADMIN_USER=bimon
ADMIN_PASS=doi-mat-khau-nay

# (Tuỳ chọn) Gửi email báo khi có khách đặt. Dùng email tên miền tạo trong Hostinger.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=datphong@bimonhomestay.com
SMTP_PASS=
NOTIFY_EMAIL=email-cua-ban@gmail.com

# (Tuỳ chọn) Báo qua Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
