# Sao chép thành .env khi chạy trên máy. Trên Hostinger: khai báo trong phần Environment variables của app Node.js.
PORT=3000
# Tên miền chính thức (để trống khi chưa có tên miền)
SITE_URL=

# Phòng trống: URL ứng dụng web Google Apps Script (xem scripts/google-apps-script.gs)
AVAILABILITY_URL=

# Đánh giá Google tự động (Google Cloud > Places API (New) > API key; lấy place id bằng: npm run google:place-id)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_MAPS_URL=https://share.google/xh4tSK7Lf7EP9lr3K

