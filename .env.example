# Sao chép thành .env khi chạy trên máy. Trên Hostinger: khai báo trong phần Environment variables của app Node.js.
PORT=3000
# Tên miền chính thức (để trống khi chưa có tên miền)
SITE_URL=

# Đăng nhập trang /admin để xem yêu cầu đặt phòng
ADMIN_USER=bimon
ADMIN_PASS=doi-mat-khau-nay

# Báo đặt phòng qua Zalo Bot (tạo bot tại https://bot.zapps.me, lấy chat id bằng: npm run zalo:chat-id)
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=

# Đánh giá Google tự động (Google Cloud > Places API (New) > API key; lấy place id bằng: npm run google:place-id)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_MAPS_URL=https://share.google/xh4tSK7Lf7EP9lr3K

# (Tuỳ chọn) Email dự phòng
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
